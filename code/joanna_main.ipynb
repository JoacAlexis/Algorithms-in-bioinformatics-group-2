    "# Read peptide file\n",
    "def load_peptide_data(file_name):\n",
    "\n",
    "    peptide_file = os.path.join(DATA_DIR, file_name)\n",
    "    loaded_peptides = np.loadtxt(peptide_file, dtype=str)\n",
    "\n",
    "    peptides = []\n",
    "\n",
    "    for line in loaded_peptides:\n",
    "\n",
